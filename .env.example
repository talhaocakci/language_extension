# Extension Configuration

# Backend API Configuration (Optional)
REACT_APP_API_ENDPOINT=https://your-api.example.com/api
REACT_APP_API_TOKEN=your-bearer-token

# LLM Configuration (Required for AI features)
REACT_APP_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
REACT_APP_LLM_API_KEY=sk-your-openai-key
REACT_APP_LLM_MODEL=gpt-4

# Alternative LLM Endpoints:

# Anthropic Claude
# REACT_APP_LLM_ENDPOINT=https://api.anthropic.com/v1/messages
# REACT_APP_LLM_API_KEY=sk-ant-your-key
# REACT_APP_LLM_MODEL=claude-3-opus-20240229

# Ollama (Local)
# REACT_APP_LLM_ENDPOINT=http://localhost:11434/api/chat
# REACT_APP_LLM_API_KEY=
# REACT_APP_LLM_MODEL=mistral

# LocalAI
# REACT_APP_LLM_ENDPOINT=http://localhost:8080/v1/chat/completions
# REACT_APP_LLM_API_KEY=test
# REACT_APP_LLM_MODEL=ggml-model-name

# Extension Settings
REACT_APP_THEME=light
REACT_APP_LANGUAGE=en
REACT_APP_AUTO_SAVE=false
