{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "GetFluentFast",
  "version": "1.0.0",
  "description": "Learn languages in the moment with interactive subtitles on YouTube, Netflix, and more",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "identity",
    "offscreen",
    "tabCapture"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://www.youtube.com/*",
    "https://netflix.com/*",
    "https://www.netflix.com/*",
    "https://*.netflix.com/*",
    "https://max.com/*",
    "https://www.max.com/*",
    "https://*.max.com/*",
    "https://hbomax.com/*",
    "https://www.hbomax.com/*",
    "https://*.hbomax.com/*",
    "https://auth.getfluentfast.app/*",
    "https://api.getfluentfast.app/*",
    "https://getfluentfast-media.s3.amazonaws.com/*",
    "https://getfluentfast-media.s3.eu-central-1.amazonaws.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/youtube-injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.netflix.com/*", "https://netflix.com/*"],
      "js": ["content/netflix-injector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://max.com/*",
        "https://www.max.com/*",
        "https://*.max.com/*",
        "https://hbomax.com/*",
        "https://www.hbomax.com/*",
        "https://*.hbomax.com/*"
      ],
      "js": ["content/netflix-injector.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "GetFluentFast"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "public/youtube-caption-fetcher.js"],
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://netflix.com/*",
        "https://*.netflix.com/*",
        "https://max.com/*",
        "https://*.max.com/*",
        "https://hbomax.com/*",
        "https://*.hbomax.com/*"
      ]
    }
  ]
}
