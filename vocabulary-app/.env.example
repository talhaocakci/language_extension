# Copy this file to .env.local and fill in your values

# Cognito Hosted UI domain (no trailing slash)
VITE_COGNITO_DOMAIN=https://your-pool.auth.eu-west-1.amazoncognito.com

# App client ID from Cognito User Pool
VITE_COGNITO_CLIENT_ID=your_client_id_here

# OAuth redirect URI — must be registered in the Cognito app client
# Dev:  http://localhost:5173/callback
# Prod: https://your-deployed-app.com/callback
VITE_REDIRECT_URI=http://localhost:5173/callback

# API Gateway base URL (no trailing slash)
VITE_API_BASE_URL=https://your-api-id.execute-api.eu-west-1.amazonaws.com/prod
